<Project>
    <!-- 先继承仓库根的公共设置，再加测试项目共有的部分 -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <!-- 测试代码不要求写文档注释 -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <!--
      TestKit 是普通类库，Tests.Aot 是 Native AOT 冒烟用的控制台程序（由 CI 的 aot 任务发布后运行），
      其余都是 xUnit v3 测试项目（本身是可执行程序，由 Microsoft Testing Platform 运行，见 global.json）
    -->
    <PropertyGroup Condition="'$(MSBuildProjectName)' != 'EasyQuerySharp.TestKit' and '$(MSBuildProjectName)' != 'EasyQuerySharp.Tests.Aot'">
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup Condition="'$(MSBuildProjectName)' != 'EasyQuerySharp.Tests.Aot'">
        <Using Include="Xunit" />
    </ItemGroup>
</Project>
