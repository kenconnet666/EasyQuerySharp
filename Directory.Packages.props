<Project>
    <!-- 中央包版本管理：版本只写在这里，项目里的 PackageReference 不带 Version -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <!-- 允许在这里固定传递依赖的版本，用来压掉驱动带进来的有漏洞的旧版本 -->
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <!-- 测试 -->
    <ItemGroup>
        <PackageVersion Include="xunit.v3" Version="4.0.2" />
        <PackageVersion Include="xunit.v3.assert" Version="4.0.2" />
        <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    </ItemGroup>

    <!-- 分析器 -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
        <!-- 公共 API 基线（只在 EasyQuerySharp 里作为开发期分析器引用，不进运行时依赖） -->
        <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0" />
    </ItemGroup>

    <!-- 基准；对比用的 ORM 只在 benchmarks/EasyQuerySharp.Benchmarks 里引用（ROADMAP 5.2） -->
    <ItemGroup>
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
        <PackageVersion Include="Dapper" Version="2.1.89" />
        <PackageVersion Include="FreeSql.Provider.SqliteCore" Version="3.5.311" />
        <PackageVersion Include="SqlSugarCore" Version="5.1.4.221" />
    </ItemGroup>

    <!-- 依赖注入：扩展包只引用抽象包，容器本身只在测试里引用 -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    </ItemGroup>

    <!-- 二级缓存（0007）：缓存包只引用 HybridCache，它带上 Caching.Abstractions / Memory、Options、Logging.Abstractions -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
    </ItemGroup>

    <!-- 数据库驱动 -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
        <PackageVersion Include="MySqlConnector" Version="2.6.2" />
        <PackageVersion Include="Npgsql" Version="10.0.3" />
        <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
        <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
        <PackageVersion Include="DuckDB.NET.Data.Full" Version="1.5.6" />
    </ItemGroup>

    <!-- 第二档方言的测试驱动：只在 TestKit 里引用，用于实库冒烟（核心不引用驱动） -->
    <ItemGroup>
        <PackageVersion Include="DM.DmProvider" Version="8.3.1.47463" />
    </ItemGroup>

    <!-- 传递依赖的安全修复：SqlClient、Oracle 驱动引用的 Pkcs 有 GHSA-2fmv-rv2c-59x7，固定到已修复版本 -->
    <ItemGroup>
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    </ItemGroup>
</Project>
