<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>EasyQuerySharp.Caching</PackageId>
        <Description>EasyQuerySharp 的二级缓存（对应 easy-query 的 sql-cache）：按主键（kv）与按条件的主键索引（all）缓存实体，存储用 HybridCache（本机与分布式两级），经本库的写入自动失效。</Description>
        <PackageTags>$(PackageTags);cache;hybridcache</PackageTags>
    </PropertyGroup>

    <!--
      只引用 HybridCache（见 0007 与 ROADMAP "新依赖只进各自的包"）；公共 API 基线的规则与核心相同。
      核心的 PrivateAssets=none：包依赖默认排除 analyzers，只装这个包的项目就拿不到核心自带的生成器
    -->
    <ItemGroup>
        <ProjectReference Include="..\EasyQuerySharp\EasyQuerySharp.csproj" PrivateAssets="none" />
        <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    </ItemGroup>

</Project>
