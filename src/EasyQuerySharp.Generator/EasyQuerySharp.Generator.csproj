<Project Sdk="Microsoft.NET.Sdk">

    <!--
      分析器与代码修复（以后也放源码生成器），随核心包分发。必须是 netstandard2.0（编译器在任意宿主里加载它）。
      Roslyn 用 4.14：不能高于使用者 SDK 自带的编译器版本，否则分析器加载不了。
    -->

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>disable</ImplicitUsings>
        <!-- RS1033 要求说明以英文句号结尾，与中文说明冲突 -->
        <NoWarn>$(NoWarn);RS1033</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    </ItemGroup>

    <!-- 规则的发布记录（RS2008）在 AnalyzerReleases.*.md：Microsoft.CodeAnalysis.Analyzers 会自动把它们加进 AdditionalFiles；新规则先写进 Unshipped，发布时挪到 Shipped -->

</Project>
