<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>EasyQuerySharp</PackageId>
        <Description>easy-query 的 C# 实现：基于表达式树的强类型 ORM，支持隐式 join、隐式子查询与 DTO 对象树。</Description>
        <PackageTags>$(PackageTags);mysql;postgresql;sqlite;sqlserver;oracle</PackageTags>
        <!-- 裁剪 / Native AOT：分析器在编译期报出本库里的问题；实体与 DTO 的成员由生成器保留，见 docs/decisions/0008-native-aot.md -->
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <!--
      公共 API 基线：改了公开成员就要同步 PublicAPI.Unshipped.txt（RS0016 / RS0017），发布时把 Unshipped 挪进 Shipped。
      分析器包会自己把 PublicAPI.*.txt 加进 AdditionalFiles，不用再登记。
      RS0026 / RS0027 禁止多个带可选参数的重载，与本库"可选 CancellationToken"的约定冲突，关掉。
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
    </PropertyGroup>

    <!--
      生成器与分析器随核心包分发，打进 analyzers/dotnet/cs：引用核心包就自带 [Projection] 生成器和查询分析器，它不是运行时依赖。
      这个引用只用来先构建生成器、取到它的程序集。ReferenceOutputAssembly=false：不编译引用，NuGet 也不把它算进依赖图，所以不成为包依赖、
      不传给引用核心的项目（仓库里要用生成器的项目自己以 Analyzer 方式引用，如 Tests.Upstream）。
      输出放进自定义的 BundledAnalyzer 而不是 Analyzer：核心自己实现了那些"只能写在查询里"的方法，在核心上跑分析器会误报 EQ0007。
    -->
    <ItemGroup>
        <ProjectReference Include="..\EasyQuerySharp.Generator\EasyQuerySharp.Generator.csproj" OutputItemType="BundledAnalyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackBundledAnalyzers</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="PackBundledAnalyzers" DependsOnTargets="ResolveProjectReferences">
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(BundledAnalyzer)" PackagePath="analyzers/dotnet/cs" />
        </ItemGroup>
    </Target>

</Project>
