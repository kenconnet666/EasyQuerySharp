<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>easy-query 的 C# 实现：基于表达式树的强类型 ORM，支持隐式 join、隐式子查询与 DTO 对象树。</Description>
    </PropertyGroup>

    <!--
      公共 API 基线：改了公开成员就要同步 PublicAPI.Unshipped.txt（RS0016 / RS0017），发布时把 Unshipped 挪进 Shipped。
      RS0026 / RS0027 禁止多个带可选参数的重载，与本库"可选 CancellationToken"的约定冲突，关掉。
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
        <AdditionalFiles Include="PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    </ItemGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
    </PropertyGroup>

</Project>
