<Project>
    <!-- 先继承仓库根的公共设置，再加发布相关的部分：src 下是随 NuGet 包发布的程序集（生成器打进核心包，见 EasyQuerySharp.csproj） -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <!--
      VersionPrefix 是下一个要发布的版本，发布后改成再下一个。发布流程（.github/workflows/release.yml）核对 tag 与它一致；
      CI 打包时传 -p:CiBuildNumber=N，版本成为 1.0.0-ci.N（预览版，排在 1.0.0 之前，不会被当成稳定版装上）。
    -->
    <PropertyGroup>
        <VersionPrefix>1.1.0</VersionPrefix>
        <VersionSuffix Condition="'$(CiBuildNumber)' != ''">ci.$(CiBuildNumber)</VersionSuffix>
    </PropertyGroup>

    <!-- NuGet 元数据；包名、说明与专属标签写在各项目里。许可证与 Java 上游相同（Apache-2.0），NOTICE 随包分发 -->
    <PropertyGroup>
        <Authors>kenconnet666</Authors>
        <Company>kenconnet666</Company>
        <PackageProjectUrl>https://github.com/kenconnet666/EasyQuerySharp</PackageProjectUrl>
        <RepositoryUrl>$(PackageProjectUrl).git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReleaseNotes>$(PackageProjectUrl)/releases</PackageReleaseNotes>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>orm;sql;linq;expression-tree;easy-query</PackageTags>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <Copyright>Copyright 2026 kenconnet666</Copyright>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
        <None Include="$(MSBuildThisFileDirectory)..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <!--
      符号与可复现构建。.NET 8 起 SDK 自带 GitHub 的 Source Link，Deterministic、EmbedUntrackedSources 也默认开启，这里只补默认关着的：
      nuspec 写入仓库地址与提交号，pdb 单独打成 .snupkg；CI 上按正式构建处理（源码路径规范成 /_/），本地不开，调试器才能找到本机源文件。
    -->
    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>
</Project>
